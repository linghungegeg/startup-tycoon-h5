generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String          @id @default(uuid()) @db.VarChar(36)
  username     String          @unique @db.VarChar(24)
  passwordHash String          @db.VarChar(128)
  passwordSalt String          @db.VarChar(64)
  createdAt    DateTime        @default(now())
  sessions     AccountSession[]
  profiles     PlayerProfile[]
}

model AccountSession {
  id        String   @id @default(uuid()) @db.VarChar(36)
  token     String   @unique @db.VarChar(64)
  accountId String   @db.VarChar(36)
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model AdminUser {
  id           String          @id @default(uuid()) @db.VarChar(36)
  username     String          @unique @db.VarChar(24)
  passwordHash String          @db.VarChar(128)
  passwordSalt String          @db.VarChar(64)
  createdAt    DateTime        @default(now())
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
}

model AdminSession {
  id          String    @id @default(uuid()) @db.VarChar(36)
  token       String    @unique @db.VarChar(64)
  adminUserId String    @db.VarChar(36)
  createdAt   DateTime  @default(now())
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model AdminAuditLog {
  id          String    @id @default(uuid()) @db.VarChar(36)
  adminUserId String    @db.VarChar(36)
  action      String    @db.VarChar(64)
  targetType  String    @db.VarChar(64)
  targetId    String?   @db.VarChar(64)
  detail      String?   @db.Text
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
}

model GameServer {
  id            String          @id @db.VarChar(32)
  name          String          @db.VarChar(32)
  status        String          @db.VarChar(16)
  label         String          @db.VarChar(16)
  isRecommended Boolean         @default(false)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  profiles      PlayerProfile[]
}

model AvatarOption {
  id        String          @id @db.VarChar(32)
  name      String          @db.VarChar(32)
  glyph     String          @db.VarChar(4)
  specialty String          @db.VarChar(64)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  profiles  PlayerProfile[]
}

model PlayerProfile {
  id          String       @id @default(uuid()) @db.VarChar(36)
  accountId   String       @db.VarChar(36)
  serverId    String       @db.VarChar(32)
  avatarId    String       @db.VarChar(32)
  founderName String       @db.VarChar(16)
  companyName String       @db.VarChar(24)
  companyLevel Int         @default(1)
  cash         Int         @default(2450000)
  platformCoins Int        @default(36580)
  premiumCurrency Int      @default(8680)
  reputation   Int         @default(1256000)
  actionPower  Int         @default(120)
  actionPowerLimit Int     @default(120)
  monthlyIncome Int        @default(860000)
  monthlyExpense Int       @default(348000)
  valuation    Int         @default(4800000)
  founderEquityBasisPoints Int @default(10000)
  totalDebt    Int         @default(0)
  creditRating String      @default("A") @db.VarChar(8)
  employeeSatisfaction Int @default(82)
  customerSatisfaction Int @default(78)
  financeMonth Int        @default(1)
  operatingDay Int        @default(1)
  riskStatus   String      @default("稳健") @db.VarChar(16)
  pendingEventCount Int    @default(2)
  unreadMailCount Int      @default(1)
  debtWarning String       @default("低") @db.VarChar(8)
  createdAt   DateTime     @default(now())
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  server      GameServer   @relation(fields: [serverId], references: [id], onDelete: Restrict)
  avatar      AvatarOption @relation(fields: [avatarId], references: [id], onDelete: Restrict)
  tasks       PlayerTaskProgress[]
  financeReports CompanyFinanceReport[]
  employees   PlayerEmployee[]
  projects    PlayerProject[]

  @@unique([accountId, serverId])
  @@index([serverId])
  @@index([avatarId])
}

model EmployeeConfig {
  id        String          @id @db.VarChar(32)
  name      String          @db.VarChar(32)
  role      String          @db.VarChar(24)
  careerLevel String        @db.VarChar(16)
  rarity    String          @db.VarChar(16)
  baseSalary Int
  basePressure Int
  loyalty   Int
  growthPotential Int
  management Int
  negotiation Int
  execution  Int
  specialty String          @db.VarChar(160)
  recruitWeight Int
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  employees PlayerEmployee[]

  @@index([recruitWeight])
  @@index([sortOrder])
}

model PlayerEmployee {
  id        String        @id @default(uuid()) @db.VarChar(36)
  profileId String       @db.VarChar(36)
  configId  String       @db.VarChar(32)
  name      String       @db.VarChar(32)
  role      String       @db.VarChar(24)
  careerLevel String     @db.VarChar(16)
  rarity    String       @db.VarChar(16)
  level     Int          @default(1)
  salary    Int
  pressure  Int
  loyalty   Int
  growthPotential Int
  management Int
  negotiation Int
  execution  Int
  specialty String       @db.VarChar(160)
  equityBasisPoints Int  @default(0)
  assignedTo String?     @db.VarChar(32)
  isActive Boolean       @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  config    EmployeeConfig @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@unique([profileId, configId])
  @@index([profileId, isActive])
}

model ProjectConfig {
  id        String          @id @db.VarChar(32)
  name      String          @db.VarChar(48)
  category  String          @db.VarChar(24)
  cycleDays Int
  budget    Int
  risk      String          @db.VarChar(8)
  successRateBase Int
  revenueReward Int
  reputationReward Int
  customerSatisfactionReward Int
  failurePenalty Int
  summary   String          @db.VarChar(180)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  projects  PlayerProject[]

  @@index([sortOrder])
}

model PlayerProject {
  id        String        @id @default(uuid()) @db.VarChar(36)
  profileId String       @db.VarChar(36)
  configId  String       @db.VarChar(32)
  name      String       @db.VarChar(48)
  category  String       @db.VarChar(24)
  stage     Int          @default(1)
  progress  Int          @default(0)
  cycleDays Int
  budget    Int
  risk      String       @db.VarChar(8)
  successRateBase Int
  revenueReward Int
  reputationReward Int
  customerSatisfactionReward Int
  failurePenalty Int
  summary   String       @db.VarChar(180)
  assignedEmployeeId String? @db.VarChar(36)
  assignedEmployeeName String? @db.VarChar(32)
  status    String       @default("active") @db.VarChar(16)
  result    String?      @db.VarChar(16)
  settledAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  config    ProjectConfig @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@unique([profileId, configId])
  @@index([profileId, status])
  @@index([assignedEmployeeId])
}

model CompanyFinanceReport {
  id          String        @id @default(uuid()) @db.VarChar(36)
  profileId   String        @db.VarChar(36)
  reportMonth Int
  income      Int
  expense     Int
  netCashFlow Int
  endingCash  Int
  totalDebt   Int
  debtRatioBasisPoints Int
  riskStatus String        @db.VarChar(16)
  riskTips   String        @db.Text
  createdAt   DateTime     @default(now())
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, reportMonth])
  @@index([profileId, createdAt])
}

model TaskConfig {
  id              String               @id @db.VarChar(48)
  type            String               @db.VarChar(16)
  title           String               @db.VarChar(48)
  description     String               @db.VarChar(160)
  target          Int
  initialProgress Int                  @default(0)
  rewardLabel     String               @db.VarChar(80)
  guideAction     String               @db.VarChar(32)
  unlockKind      String               @default("none") @db.VarChar(24)
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  progresses      PlayerTaskProgress[]

  @@index([type, sortOrder])
}

model PlayerTaskProgress {
  id          String        @id @default(uuid()) @db.VarChar(36)
  profileId   String        @db.VarChar(36)
  taskId      String        @db.VarChar(48)
  progress    Int           @default(0)
  dailyDate   String?       @db.VarChar(10)
  claimedAt   DateTime?
  updatedAt   DateTime      @updatedAt
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  task        TaskConfig    @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([profileId, taskId])
  @@index([profileId, updatedAt])
  @@index([taskId])
}
