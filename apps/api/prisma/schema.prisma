  name      String       @db.VarChar(48)
  category  String       @db.VarChar(24)
  stage     String       @default("idea") @db.VarChar(16)
  users     Int          @default(0)
  retentionBasisPoints Int
  payRateBasisPoints Int
  acquisitionCost Int
  serverCost Int
  reputationScore Int    @default(50)
  techDebt  Int          @default(0)
  monthlyRevenue Int     @default(0)
  status    String       @default("active") @db.VarChar(16)
  resultSummary String?  @db.VarChar(220)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  closedAt  DateTime?
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  config    ProductConfig @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@unique([profileId, configId])
  @@index([profileId, status])
  @@index([configId])
}

model MarketTrackConfig {
  id        String        @id @db.VarChar(32)
  name      String        @db.VarChar(48)
  summary   String        @db.VarChar(180)
  costStructure String    @db.VarChar(80)
  industryHeat Int
  policyRisk Int
  baseShareBasisPoints Int
  customerPool Int
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  states    PlayerMarketState[]
  actions   CompetitorActionConfig[]

  @@index([sortOrder])
}

model PlayerMarketState {
  id        String        @id @default(uuid()) @db.VarChar(36)
  profileId String       @db.VarChar(36)
  trackId   String       @db.VarChar(32)
  trackName String       @db.VarChar(48)
  playerShareBasisPoints Int
  competitorShareBasisPoints Int
  industryHeat Int
  policyRisk Int
  pricePressure Int      @default(0)
  talentPressure Int     @default(0)
  reputationPressure Int @default(0)
  patentRisk Int         @default(0)
  resultSummary String?  @db.VarChar(220)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  track     MarketTrackConfig @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@unique([profileId, trackId])
  @@index([profileId])
  @@index([trackId])
}

model CompetitorActionConfig {
  id        String        @id @db.VarChar(40)
  trackId   String       @db.VarChar(32)
  competitorName String  @db.VarChar(48)
  actionType String      @db.VarChar(24)
  title     String       @db.VarChar(64)
  summary   String       @db.VarChar(180)
  cashImpact Int
  monthlyIncomeImpact Int
  monthlyExpenseImpact Int
  reputationImpact Int
  employeeSatisfactionImpact Int
  customerSatisfactionImpact Int
  marketShareDeltaBasisPoints Int
  competitorShareDeltaBasisPoints Int
  pricePressure Int
  talentPressure Int
  policyRiskDelta Int
  responseCost Int
  responseShareDeltaBasisPoints Int
  responseReputationImpact Int
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  track     MarketTrackConfig @relation(fields: [trackId], references: [id], onDelete: Cascade)
  playerActions PlayerCompetitorAction[]

  @@index([trackId, sortOrder])
  @@index([actionType])
}

model PlayerCompetitorAction {
  id        String        @id @default(uuid()) @db.VarChar(36)
  profileId String       @db.VarChar(36)
  actionId  String       @db.VarChar(40)
  trackId   String       @db.VarChar(32)
  competitorName String  @db.VarChar(48)
  actionType String      @db.VarChar(24)
  title     String       @db.VarChar(64)
  summary   String       @db.VarChar(180)
  status    String       @default("pending") @db.VarChar(16)
  response  String?      @db.VarChar(16)
  resultSummary String?  @db.VarChar(220)
  createdAt DateTime     @default(now())
  resolvedAt DateTime?
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  config    CompetitorActionConfig @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@index([profileId, status])
  @@index([actionId])
}

model CompanyFinanceReport {
  id          String        @id @default(uuid()) @db.VarChar(36)
  profileId   String        @db.VarChar(36)
  reportMonth Int
  income      Int
  expense     Int
  netCashFlow Int
  endingCash  Int
  totalDebt   Int
  debtRatioBasisPoints Int
  riskStatus String        @db.VarChar(16)
  riskTips   String        @db.Text
  createdAt   DateTime     @default(now())
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, reportMonth])
  @@index([profileId, createdAt])
}

model TaskConfig {
  id              String               @id @db.VarChar(48)
  type            String               @db.VarChar(16)
  title           String               @db.VarChar(48)
  description     String               @db.VarChar(160)
  target          Int
  initialProgress Int                  @default(0)
  rewardLabel     String               @db.VarChar(80)
  rewardCash      Int                  @default(0)
  rewardPlatformCoins Int              @default(0)
  rewardReputation Int                 @default(0)
  rewardActionPower Int                @default(0)
  rewardCompanyExperience Int          @default(0)
  rewardItemId      String?            @db.VarChar(40)
  rewardItemQuantity Int               @default(0)
  guideAction     String               @db.VarChar(32)
  unlockKind      String               @default("none") @db.VarChar(24)
  knowledgeId     String?              @db.VarChar(48)
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  rewardItem      ItemConfig?          @relation("TaskRewardItem", fields: [rewardItemId], references: [id], onDelete: SetNull)
  progresses      PlayerTaskProgress[]

  @@index([type, sortOrder])
  @@index([rewardItemId])
  @@index([knowledgeId])
}

model RandomTaskConfig {
  id              String             @id @db.VarChar(48)
  category        String             @db.VarChar(24)
  title           String             @db.VarChar(48)
  description     String             @db.VarChar(180)
  source          String             @db.VarChar(32)
  optionALabel    String             @db.VarChar(40)
  optionAResult   String             @db.VarChar(160)
  optionAActionPower Int             @default(0)
  optionACash     Int                @default(0)
  optionAReputation Int              @default(0)
  optionACompanyExperience Int       @default(0)
  optionBLabel    String             @db.VarChar(40)
  optionBResult   String             @db.VarChar(160)
  optionBActionPower Int             @default(0)
  optionBCash     Int                @default(0)
  optionBReputation Int              @default(0)
  optionBCompanyExperience Int       @default(0)
  riskLabel       String             @db.VarChar(32)
  knowledgeId     String?            @db.VarChar(48)
  sortOrder       Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  playerTasks     PlayerRandomTask[]

  @@index([category, sortOrder])
  @@index([knowledgeId])
}

model PlayerRandomTask {
  id          String           @id @default(uuid()) @db.VarChar(36)
  profileId   String           @db.VarChar(36)
  configId    String           @db.VarChar(48)
  dailyDate   String           @db.VarChar(10)
  status      String           @default("pending") @db.VarChar(16)
  selectedOption String?       @db.VarChar(1)
  resultSummary String?        @db.VarChar(180)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?
  profile     PlayerProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  config      RandomTaskConfig @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@unique([profileId, configId, dailyDate])
  @@index([profileId, status, dailyDate])
  @@index([configId])
}

model PlayerTaskProgress {
  id          String        @id @default(uuid()) @db.VarChar(36)
  profileId   String        @db.VarChar(36)
  taskId      String        @db.VarChar(48)
  progress    Int           @default(0)
  dailyDate   String?       @db.VarChar(10)
  claimedAt   DateTime?
  updatedAt   DateTime      @updatedAt
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  task        TaskConfig    @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([profileId, taskId])
  @@index([profileId, updatedAt])
  @@index([taskId])
}
