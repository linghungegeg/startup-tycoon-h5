generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String          @id @default(uuid()) @db.VarChar(36)
  username     String          @unique @db.VarChar(24)
  passwordHash String          @db.VarChar(128)
  passwordSalt String          @db.VarChar(64)
  createdAt    DateTime        @default(now())
  sessions     AccountSession[]
  profiles     PlayerProfile[]
}

model AccountSession {
  id        String   @id @default(uuid()) @db.VarChar(36)
  token     String   @unique @db.VarChar(64)
  accountId String   @db.VarChar(36)
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model AdminUser {
  id           String          @id @default(uuid()) @db.VarChar(36)
  username     String          @unique @db.VarChar(24)
  passwordHash String          @db.VarChar(128)
  passwordSalt String          @db.VarChar(64)
  createdAt    DateTime        @default(now())
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
  platformCoinLedgers PlatformCoinLedger[]
  mailCompensations AdminMailCompensation[]
}

model AdminSession {
  id          String    @id @default(uuid()) @db.VarChar(36)
  token       String    @unique @db.VarChar(64)
  adminUserId String    @db.VarChar(36)
  createdAt   DateTime  @default(now())
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model AdminAuditLog {
  id          String    @id @default(uuid()) @db.VarChar(36)
  adminUserId String    @db.VarChar(36)
  action      String    @db.VarChar(64)
  targetType  String    @db.VarChar(64)
  targetId    String?   @db.VarChar(64)
  detail      String?   @db.Text
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
}

model AdminMailCompensation {
  id          String        @id @default(uuid()) @db.VarChar(36)
  profileId   String        @db.VarChar(36)
  adminUserId String        @db.VarChar(36)
  subject     String        @db.VarChar(80)
  body        String        @db.VarChar(220)
  platformCoins Int        @default(0)
  reason      String        @db.VarChar(160)
  createdAt   DateTime      @default(now())
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  adminUser   AdminUser     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([profileId, createdAt])
  @@index([adminUserId, createdAt])
}

model PlayerTelemetryEvent {
  id          String   @id @default(uuid()) @db.VarChar(36)
  accountId   String   @db.VarChar(36)
  profileId   String?  @db.VarChar(36)
  serverId    String   @db.VarChar(32)
  eventName   String   @db.VarChar(48)
  targetId    String?  @db.VarChar(64)
  metadataJson String? @db.Text
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([serverId, eventName])
  @@index([eventName, createdAt])
}

model ApiRequestLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  traceId     String   @db.VarChar(64)
  method      String   @db.VarChar(8)
  path        String   @db.VarChar(220)
  statusCode  Int
  durationMs  Int
  createdAt   DateTime @default(now())

  @@index([statusCode, createdAt])
  @@index([durationMs, createdAt])
  @@index([traceId])
}

model GameServer {
  id            String          @id @db.VarChar(32)
  name          String          @db.VarChar(32)
  status        String          @db.VarChar(16)
  label         String          @db.VarChar(16)
  isRecommended Boolean         @default(false)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  profiles      PlayerProfile[]
  crossServerMemberships CrossServerGroupServer[]
}

model CrossServerGroup {
  id          String        @id @db.VarChar(32)
  name        String        @db.VarChar(48)
  ruleLabel   String        @db.VarChar(120)
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  servers     CrossServerGroupServer[]
  signups     CrossServerSignup[]
  guildSignups CrossServerGuildSignup[]
  arenaStates PlayerCrossServerArenaState[]

  @@index([isActive, sortOrder])
}

model CrossServerGroupServer {
  id          String        @id @default(uuid()) @db.VarChar(36)
  groupId     String        @db.VarChar(32)
  serverId    String        @db.VarChar(32)
  sortOrder   Int           @default(0)
  group       CrossServerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  server      GameServer    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId])
  @@index([groupId, sortOrder])
}

model CrossServerSignup {
  id          String        @id @default(uuid()) @db.VarChar(36)
  groupId     String        @db.VarChar(32)
  profileId   String        @db.VarChar(36)
  serverId    String        @db.VarChar(32)
  signupDate  String        @db.VarChar(10)
  status      String        @default("active") @db.VarChar(16)
  createdAt   DateTime      @default(now())
  group       CrossServerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, groupId])
  @@index([groupId, status])
  @@index([serverId, status])
}

model CrossServerGuildSignup {
  id          String        @id @default(uuid()) @db.VarChar(36)
  groupId     String        @db.VarChar(32)
  guildId     String        @db.VarChar(36)
  serverId    String        @db.VarChar(32)
  signupDate  String        @db.VarChar(10)
  status      String        @default("active") @db.VarChar(16)
  createdAt   DateTime      @default(now())
  group       CrossServerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  guild       Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, groupId])
  @@index([groupId, status])
  @@index([serverId, status])
}

model AvatarOption {
  id        String          @id @db.VarChar(32)
  name      String          @db.VarChar(32)
  glyph     String          @db.VarChar(4)
  specialty String          @db.VarChar(64)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  profiles  PlayerProfile[]
}

model PlayerProfile {
  id          String       @id @default(uuid()) @db.VarChar(36)
  accountId   String       @db.VarChar(36)
  serverId    String       @db.VarChar(32)
  avatarId    String       @db.VarChar(32)
  founderName String       @db.VarChar(16)
  companyName String       @db.VarChar(24)
  companyLevel Int         @default(1)
  companyExperience Int    @default(0)
  cash         Int         @default(2450000)
  platformCoins Int        @default(36580)
  premiumCurrency Int      @default(8680)
  reputation   Int         @default(1256000)
  actionPower  Int         @default(120)
  actionPowerLimit Int     @default(120)
  actionPowerRecoveredAt DateTime @default(now())
  monthlyIncome Int        @default(860000)
  monthlyExpense Int       @default(348000)
  valuation    Int         @default(4800000)
  founderEquityBasisPoints Int @default(10000)
  totalDebt    Int         @default(0)
  creditRating String      @default("A") @db.VarChar(8)
  employeeSatisfaction Int @default(82)
  employeeRecruitPityCount Int @default(0)
  limitedEmployeeRecruitPityCount Int @default(0)
  customerSatisfaction Int @default(78)
  financeMonth Int        @default(1)
  operatingDay Int        @default(1)
  riskStatus   String      @default("稳健") @db.VarChar(16)
  pendingEventCount Int    @default(2)
  unreadMailCount Int      @default(1)
  debtWarning String       @default("低") @db.VarChar(8)
  businessClockSyncedAt DateTime?
  lastBusinessPulseSummaryJson String? @db.Text
  status      String       @default("active") @db.VarChar(16)
  createdAt   DateTime     @default(now())
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  server      GameServer   @relation(fields: [serverId], references: [id], onDelete: Restrict)
  avatar      AvatarOption @relation(fields: [avatarId], references: [id], onDelete: Restrict)
  tasks       PlayerTaskProgress[]
  financeReports CompanyFinanceReport[]
  employees   PlayerEmployee[]
  projects    PlayerProject[]
  events      PlayerEvent[]
  loans       PlayerLoan[]
  fundings    PlayerFunding[]
  products    PlayerProduct[]
  markets     PlayerMarketState[]
  competitorActions PlayerCompetitorAction[]
  platformWallet PlayerPlatformWallet?
  platformCoinLedgers PlatformCoinLedger[]
  shopPurchases PlayerShopPurchase[]
  privilegeDailyClaims PlayerPrivilegeDailyClaim[]
  paymentOrders ExternalPaymentOrder[]
  vipDailyGifts PlayerVipDailyGift[]
  leaderboardRewards LeaderboardRewardDelivery[]
  playerTitles PlayerTitle[]
  titleEquipment PlayerTitleEquipment?
  achievements PlayerAchievement[]
  knowledgeUnlocks PlayerKnowledgeUnlock[]
  guildMembership GuildMember?
  guildHelpRequests GuildHelpRequest[]
  guildJoinRequests GuildJoinRequest[]
  guildActivityLogs GuildActivityLog[]
  crossServerSignups CrossServerSignup[]
  crossServerArenaState PlayerCrossServerArenaState?
  mailCompensations AdminMailCompensation[]
  seasonProgresses PlayerSeasonProgress[]
  seasonTasks PlayerSeasonTaskProgress[]
  seasonPassPurchases PlayerSeasonPassPurchase[]
  activityStates PlayerActivityState[]
  activityShopPurchases PlayerActivityShopPurchase[]
  scenarioRuns PlayerScenarioRun[]
  inventoryItems PlayerInventoryItem[]
  itemLedgers PlayerItemLedger[]
  randomTasks PlayerRandomTask[]

  @@unique([accountId, serverId])
  @@index([serverId])
  @@index([avatarId])
}

model PlayerCrossServerArenaState {
  id                 String        @id @default(uuid()) @db.VarChar(36)
  profileId          String        @unique @db.VarChar(36)
  groupId            String        @db.VarChar(32)
  rank               Int           @default(1200)
  attemptsRemaining  Int           @default(10)
  lastRecoveredAt    DateTime
  recoverUsedDate    String        @default("") @db.VarChar(10)
  vipRecoverUsed     Int           @default(0)
  lastBattleReportJson String?     @db.Text
  lastSettlementDate String?       @db.VarChar(10)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  profile            PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  group              CrossServerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, rank])
}

model CrossServerRuleConfig {
  id                              String   @id @db.VarChar(32)
  personalAttemptLimit            Int      @default(10)
  personalRecoverIntervalMinutes  Int      @default(60)
  personalResetTime               String   @default("05:00") @db.VarChar(5)
  personalSettlementTime          String   @default("22:00") @db.VarChar(5)
  guildOpenDay                    Int      @default(6)
  guildOpenTime                   String   @default("20:00") @db.VarChar(5)
  guildCloseDay                   Int      @default(0)
  guildCloseTime                  String   @default("22:00") @db.VarChar(5)
  guildSettlementTime             String   @default("22:00") @db.VarChar(5)
  rewardTiersJson                 String   @db.Text
  updatedAt                       DateTime @updatedAt
}

model CrossServerSettlementRun {
  id               String   @id @default(uuid()) @db.VarChar(36)
  settlementType   String   @db.VarChar(16)
  settlementKey    String   @unique @db.VarChar(64)
  status           String   @db.VarChar(16)
  deliveredRewards Int      @default(0)
  errorMessage     String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([settlementType, createdAt])
}

model PlayerPlatformWallet {
  id          String        @id @default(uuid()) @db.VarChar(36)
  profileId   String        @unique @db.VarChar(36)
  balance     Int
  totalSpent  Int           @default(0)
  vipExperience Int         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ledgers     PlatformCoinLedger[]
  vipDailyGifts PlayerVipDailyGift[]
}

model VipLevelConfig {
  level       Int           @id
  name        String        @db.VarChar(32)
  requiredExperience Int
  dailyGiftPlatformCoins Int @default(0)
  dailyGiftActionPower Int   @default(0)
  actionPowerLimitBonus Int  @default(0)
  quickSettleTimes Int       @default(0)
  trainingQueueBonus Int     @default(0)
  recruitRefreshTimes Int    @default(0)
  shopDiscountBasisPoints Int @default(10000)
  title       String        @db.VarChar(32)
  avatarFrame String        @db.VarChar(32)
  summary     String        @db.VarChar(180)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([requiredExperience])
  @@index([sortOrder])
}

model PlayerVipDailyGift {
  id          String        @id @default(uuid()) @db.VarChar(36)
  profileId   String        @db.VarChar(36)
  walletId    String        @db.VarChar(36)
  vipLevel    Int
  giftDate    String        @db.VarChar(10)
  rewardPlatformCoins Int
  rewardActionPower Int
  createdAt   DateTime      @default(now())
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  wallet      PlayerPlatformWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([profileId, giftDate])
  @@index([walletId, createdAt])
}

model SeasonConfig {
  id          String   @id @db.VarChar(40)
  name        String   @db.VarChar(64)
  theme       String   @db.VarChar(64)
  startDate   String   @db.VarChar(10)
  endDate     String   @db.VarChar(10)
  passPricePlatformCoins Int @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  tasks       SeasonTaskConfig[]
  progresses  PlayerSeasonProgress[]
  passPurchases PlayerSeasonPassPurchase[]
  activities  ActivityConfig[]
  shopItems   ActivityShopItemConfig[]

  @@index([startDate, endDate])
  @@index([sortOrder])
}

model SeasonTaskConfig {
  id          String   @id @db.VarChar(48)
  seasonId    String   @db.VarChar(40)
  title       String   @db.VarChar(64)
  description String   @db.VarChar(180)
  target      Int
  rewardPoints Int
  rewardItemId String? @db.VarChar(40)
  rewardItemQuantity Int @default(0)
  sortOrder   Int      @default(0)
  season      SeasonConfig @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  rewardItem  ItemConfig? @relation("SeasonTaskRewardItem", fields: [rewardItemId], references: [id], onDelete: SetNull)
  progresses  PlayerSeasonTaskProgress[]

  @@index([seasonId, sortOrder])
  @@index([rewardItemId])
}

model PlayerSeasonProgress {
  id          String   @id @default(uuid()) @db.VarChar(36)
  profileId   String   @db.VarChar(36)
  seasonId    String   @db.VarChar(40)
  points      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  season      SeasonConfig @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([profileId, seasonId])
  @@index([seasonId, points])
}

model PlayerSeasonTaskProgress {
  id          String   @id @default(uuid()) @db.VarChar(36)
  profileId   String   @db.VarChar(36)
  taskId      String   @db.VarChar(48)
  progress    Int      @default(0)
  claimedAt   DateTime?
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  task        SeasonTaskConfig @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([profileId, taskId])
  @@index([profileId, claimedAt])
}

model PlayerSeasonPassPurchase {
  id          String   @id @default(uuid()) @db.VarChar(36)
  profileId   String   @db.VarChar(36)
  seasonId    String   @db.VarChar(40)
  requestId   String   @db.VarChar(64)
  pricePlatformCoins Int
  createdAt   DateTime @default(now())
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  season      SeasonConfig @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([profileId, seasonId])
  @@unique([profileId, requestId])
}

model ActivityConfig {
  id          String   @id @db.VarChar(48)
  seasonId    String   @db.VarChar(40)
  name        String   @db.VarChar(64)
  startDate   String   @db.VarChar(10)
  endDate     String   @db.VarChar(10)
  leaderboardKey String @db.VarChar(48)
  targetScore Int
  progressMode String   @default("target") @db.VarChar(16)
  progressScore Int     @default(100)
  dailyProgressLimit Int @default(1)
  actionPowerCost Int   @default(0)
  rewardCash  Int      @default(0)
  rewardReputation Int @default(0)
  rewardPoints Int     @default(0)
  rewardTitleId String? @db.VarChar(40)
  sortOrder   Int      @default(0)
  season      SeasonConfig @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  states      PlayerActivityState[]

  @@index([seasonId, startDate, endDate])
}

model ActivityConfigDraft {
  id          String   @id @default(uuid()) @db.VarChar(36)
  activityId  String   @unique @db.VarChar(48)
  name        String   @db.VarChar(64)
  startDate   String   @db.VarChar(10)
  endDate     String   @db.VarChar(10)
  leaderboardKey String @db.VarChar(48)
  targetScore Int
  progressMode String   @default("target") @db.VarChar(16)
  progressScore Int     @default(100)
  dailyProgressLimit Int @default(1)
  actionPowerCost Int   @default(0)
  rewardCash  Int      @default(0)
  rewardPlatformCoins Int @default(0)
  rewardReputation Int @default(0)
  rewardPoints Int     @default(0)
  rewardTitleId String? @db.VarChar(40)
  status      String   @db.VarChar(24)
  createdByAdminUserId String @db.VarChar(36)
  updatedByAdminUserId String @db.VarChar(36)
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewedByAdminUserId String? @db.VarChar(36)
  reviewNote  String?  @db.VarChar(180)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, updatedAt])
}

model PlayerActivityState {
  id          String   @id @default(uuid()) @db.VarChar(36)
  profileId   String   @db.VarChar(36)
  activityId  String   @db.VarChar(48)
  isJoined    Boolean  @default(false)
  score       Int      @default(0)
  dailyProgressDate String? @db.VarChar(10)
  dailyProgressCount Int @default(0)
  rewardClaimedAt DateTime?
  updatedAt   DateTime @updatedAt
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  activity    ActivityConfig @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([profileId, activityId])
  @@index([activityId, score])
}

model ActivityShopItemConfig {
  id          String   @id @db.VarChar(48)
  seasonId    String   @db.VarChar(40)
  name        String   @db.VarChar(64)
  costPoints  Int
  rewardActionPower Int @default(0)
  rewardReputation Int @default(0)
  rewardItemId String? @db.VarChar(40)
  rewardItemQuantity Int @default(0)
  purchaseLimit Int    @default(0)
  summary     String   @db.VarChar(180)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  season      SeasonConfig @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  rewardItem  ItemConfig? @relation("ActivityShopRewardItem", fields: [rewardItemId], references: [id], onDelete: SetNull)
  purchases   PlayerActivityShopPurchase[]

  @@index([seasonId, sortOrder])
  @@index([rewardItemId])
}

model PlayerActivityShopPurchase {
  id          String   @id @default(uuid()) @db.VarChar(36)
  profileId   String   @db.VarChar(36)
  itemId      String   @db.VarChar(48)
  requestId   String   @db.VarChar(64)
  costPoints  Int
  createdAt   DateTime @default(now())
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  item        ActivityShopItemConfig @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([profileId, requestId])
  @@index([profileId, itemId])
}

model ItemConfig {
  id          String   @id @db.VarChar(40)
  name        String   @db.VarChar(48)
  category    String   @db.VarChar(24)
  rarity      String   @db.VarChar(16)
  icon        String   @db.VarChar(32)
  summary     String   @db.VarChar(180)
  usageHint   String   @db.VarChar(120)
  isConsumable Boolean @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  inventoryItems PlayerInventoryItem[]
  ledgers     PlayerItemLedger[]
  shopRewards ShopProductConfig[] @relation("ShopRewardItem")
  taskRewards TaskConfig[] @relation("TaskRewardItem")
  seasonTaskRewards SeasonTaskConfig[] @relation("SeasonTaskRewardItem")
  activityShopRewards ActivityShopItemConfig[] @relation("ActivityShopRewardItem")

  @@index([category, sortOrder])
}

model PlayerInventoryItem {
  id          String        @id @default(uuid()) @db.VarChar(36)
  profileId   String        @db.VarChar(36)
  itemId      String        @db.VarChar(40)
  quantity    Int           @default(0)
  updatedAt   DateTime      @updatedAt
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  item        ItemConfig    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([profileId, itemId])
  @@index([profileId])
  @@index([itemId])
}

model PlayerItemLedger {
  id          String        @id @default(uuid()) @db.VarChar(36)
  profileId   String        @db.VarChar(36)
  itemId      String        @db.VarChar(40)
  changeQuantity Int
  balanceAfter Int
  source      String        @db.VarChar(32)
  referenceId String?       @db.VarChar(64)
  reason      String        @db.VarChar(160)
  createdAt   DateTime      @default(now())
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  item        ItemConfig    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([profileId, createdAt])
  @@index([itemId])
  @@index([source])
}

model ScenarioConfig {
  id          String   @id @db.VarChar(48)
  name        String   @db.VarChar(64)
  summary     String   @db.VarChar(180)
  initialStateJson String @db.Text
  rewardCash  Int      @default(0)
  rewardReputation Int @default(0)
  rewardTitleId String? @db.VarChar(40)
  sortOrder   Int      @default(0)
  runs        PlayerScenarioRun[]
}

model PlayerScenarioRun {
  id          String   @id @default(uuid()) @db.VarChar(36)
  profileId   String   @db.VarChar(36)
  scenarioId  String   @db.VarChar(48)
  initialStateJson String @db.Text
  choicesJson String?  @db.Text
  score       Int?
  grade       String?  @db.VarChar(8)
  rewardClaimedAt DateTime?
  createdAt   DateTime @default(now())
  settledAt   DateTime?
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  scenario    ScenarioConfig @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([profileId, scenarioId, createdAt])
}

model LeaderboardSnapshot {
  id          String   @id @default(uuid()) @db.VarChar(36)
  serverId    String   @db.VarChar(32)
  boardKey    String   @db.VarChar(32)
  boardName   String   @db.VarChar(48)
  snapshotDate String  @db.VarChar(10)
  entriesJson String   @db.Text
  createdAt   DateTime @default(now())

  @@unique([serverId, boardKey, snapshotDate])
  @@index([serverId, snapshotDate])
}

model LeaderboardRewardDelivery {
  id          String        @id @default(uuid()) @db.VarChar(36)
  profileId   String        @db.VarChar(36)
  serverId    String        @db.VarChar(32)
  boardKey    String        @db.VarChar(32)
  snapshotDate String       @db.VarChar(10)
  rank        Int
  rewardPlatformCoins Int   @default(0)
  rewardTitleId String?     @db.VarChar(40)
  mailSubject String        @db.VarChar(80)
  mailBody    String        @db.VarChar(220)
  deliveredAt DateTime      @default(now())
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

