generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String          @id @default(uuid()) @db.VarChar(36)
  username     String          @unique @db.VarChar(24)
  passwordHash String          @db.VarChar(128)
  passwordSalt String          @db.VarChar(64)
  createdAt    DateTime        @default(now())
  sessions     AccountSession[]
  profiles     PlayerProfile[]
}

model AccountSession {
  id        String   @id @default(uuid()) @db.VarChar(36)
  token     String   @unique @db.VarChar(64)
  accountId String   @db.VarChar(36)
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model AdminUser {
  id           String          @id @default(uuid()) @db.VarChar(36)
  username     String          @unique @db.VarChar(24)
  passwordHash String          @db.VarChar(128)
  passwordSalt String          @db.VarChar(64)
  createdAt    DateTime        @default(now())
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
}

model AdminSession {
  id          String    @id @default(uuid()) @db.VarChar(36)
  token       String    @unique @db.VarChar(64)
  adminUserId String    @db.VarChar(36)
  createdAt   DateTime  @default(now())
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model AdminAuditLog {
  id          String    @id @default(uuid()) @db.VarChar(36)
  adminUserId String    @db.VarChar(36)
  action      String    @db.VarChar(64)
  targetType  String    @db.VarChar(64)
  targetId    String?   @db.VarChar(64)
  detail      String?   @db.Text
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
}

model GameServer {
  id            String          @id @db.VarChar(32)
  name          String          @db.VarChar(32)
  status        String          @db.VarChar(16)
  label         String          @db.VarChar(16)
  isRecommended Boolean         @default(false)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  profiles      PlayerProfile[]
}

model AvatarOption {
  id        String          @id @db.VarChar(32)
  name      String          @db.VarChar(32)
  glyph     String          @db.VarChar(4)
  specialty String          @db.VarChar(64)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  profiles  PlayerProfile[]
}

model PlayerProfile {
  id          String       @id @default(uuid()) @db.VarChar(36)
  accountId   String       @db.VarChar(36)
  serverId    String       @db.VarChar(32)
  avatarId    String       @db.VarChar(32)
  founderName String       @db.VarChar(16)
  companyName String       @db.VarChar(24)
  companyLevel Int         @default(1)
  cash         Int         @default(2450000)
  platformCoins Int        @default(36580)
  premiumCurrency Int      @default(8680)
  reputation   Int         @default(1256000)
  actionPower  Int         @default(120)
  actionPowerLimit Int     @default(120)
  monthlyIncome Int        @default(860000)
  monthlyExpense Int       @default(348000)
  valuation    Int         @default(4800000)
  founderEquityBasisPoints Int @default(10000)
  totalDebt    Int         @default(0)
  creditRating String      @default("A") @db.VarChar(8)
  employeeSatisfaction Int @default(82)
  customerSatisfaction Int @default(78)
  financeMonth Int        @default(1)
  operatingDay Int        @default(1)
  riskStatus   String      @default("稳健") @db.VarChar(16)
  pendingEventCount Int    @default(2)
  unreadMailCount Int      @default(1)
  debtWarning String       @default("低") @db.VarChar(8)
  createdAt   DateTime     @default(now())
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  server      GameServer   @relation(fields: [serverId], references: [id], onDelete: Restrict)
  avatar      AvatarOption @relation(fields: [avatarId], references: [id], onDelete: Restrict)
  tasks       PlayerTaskProgress[]
  financeReports CompanyFinanceReport[]
  employees   PlayerEmployee[]
  projects    PlayerProject[]
  events      PlayerEvent[]
  loans       PlayerLoan[]
  fundings    PlayerFunding[]
  products    PlayerProduct[]
  markets     PlayerMarketState[]
  competitorActions PlayerCompetitorAction[]

  @@unique([accountId, serverId])
  @@index([serverId])
  @@index([avatarId])
}

model EmployeeConfig {
  id        String          @id @db.VarChar(32)
  name      String          @db.VarChar(32)
  role      String          @db.VarChar(24)
  careerLevel String        @db.VarChar(16)
  rarity    String          @db.VarChar(16)
  baseSalary Int
  basePressure Int
  loyalty   Int
  growthPotential Int
  management Int
  negotiation Int
  execution  Int
  specialty String          @db.VarChar(160)
  recruitWeight Int
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  employees PlayerEmployee[]

  @@index([recruitWeight])
  @@index([sortOrder])
}

model PlayerEmployee {
  id        String        @id @default(uuid()) @db.VarChar(36)
  profileId String       @db.VarChar(36)
  configId  String       @db.VarChar(32)
  name      String       @db.VarChar(32)
  role      String       @db.VarChar(24)
  careerLevel String     @db.VarChar(16)
  rarity    String       @db.VarChar(16)
  level     Int          @default(1)
  salary    Int
  pressure  Int
  loyalty   Int
  growthPotential Int
  management Int
  negotiation Int
  execution  Int
  specialty String       @db.VarChar(160)
  equityBasisPoints Int  @default(0)
  assignedTo String?     @db.VarChar(32)
  isActive Boolean       @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  config    EmployeeConfig @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@unique([profileId, configId])
  @@index([profileId, isActive])
}

model ProjectConfig {
  id        String          @id @db.VarChar(32)
  name      String          @db.VarChar(48)
  category  String          @db.VarChar(24)
  cycleDays Int
  budget    Int
  risk      String          @db.VarChar(8)
  successRateBase Int
  revenueReward Int
  reputationReward Int
  customerSatisfactionReward Int
  failurePenalty Int
  summary   String          @db.VarChar(180)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  projects  PlayerProject[]

  @@index([sortOrder])
}

model PlayerProject {
  id        String        @id @default(uuid()) @db.VarChar(36)
  profileId String       @db.VarChar(36)
  configId  String       @db.VarChar(32)
  name      String       @db.VarChar(48)
  category  String       @db.VarChar(24)
  stage     Int          @default(1)
  progress  Int          @default(0)
  cycleDays Int
  budget    Int
  risk      String       @db.VarChar(8)
  successRateBase Int
  revenueReward Int
  reputationReward Int
  customerSatisfactionReward Int
  failurePenalty Int
  summary   String       @db.VarChar(180)
  assignedEmployeeId String? @db.VarChar(36)
  assignedEmployeeName String? @db.VarChar(32)
  status    String       @default("active") @db.VarChar(16)
  result    String?      @db.VarChar(16)
  settledAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  config    ProjectConfig @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@unique([profileId, configId])
  @@index([profileId, status])
  @@index([assignedEmployeeId])
}

model EventConfig {
  id        String        @id @db.VarChar(48)
  title     String        @db.VarChar(64)
  source    String        @db.VarChar(24)
  channel   String        @db.VarChar(16)
  summary   String        @db.VarChar(180)
  context   String        @db.Text
  optionA   String        @db.VarChar(80)
  optionAResult String    @db.VarChar(180)
  optionACash Int         @default(0)
  optionAReputation Int   @default(0)
  optionACustomerSatisfaction Int @default(0)
  optionARiskDelta Int    @default(0)
  optionB   String        @db.VarChar(80)
  optionBResult String    @db.VarChar(180)
  optionBCash Int         @default(0)
  optionBReputation Int   @default(0)
  optionBCustomerSatisfaction Int @default(0)
  optionBRiskDelta Int    @default(0)
  followupEventId String? @db.VarChar(48)
  knowledgeTitle String?  @db.VarChar(64)
  riskExplanation String  @db.VarChar(220)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  events    PlayerEvent[]

  @@index([channel, sortOrder])
}

model PlayerEvent {
  id        String        @id @default(uuid()) @db.VarChar(36)
  profileId String       @db.VarChar(36)
  configId  String       @db.VarChar(48)
  status    String       @default("pending") @db.VarChar(16)
  selectedOption String? @db.VarChar(8)
  resultSummary String?  @db.VarChar(220)
  knowledgeUnlocked Boolean @default(false)
  createdAt DateTime     @default(now())
  resolvedAt DateTime?
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  config    EventConfig   @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@unique([profileId, configId])
  @@index([profileId, status])
}

model LoanConfig {
  id        String       @id @db.VarChar(32)
  name      String       @db.VarChar(48)
  lender    String       @db.VarChar(32)
  principal Int
  annualRateBasisPoints Int
  termMonths Int
  monthlyPayment Int
  creditRequired String  @db.VarChar(8)
  summary   String       @db.VarChar(180)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  loans     PlayerLoan[]

  @@index([sortOrder])
}

model PlayerLoan {
  id        String        @id @default(uuid()) @db.VarChar(36)
  profileId String       @db.VarChar(36)
  configId  String       @db.VarChar(32)
  name      String       @db.VarChar(48)
  lender    String       @db.VarChar(32)
  principal Int
  remainingPrincipal Int
  annualRateBasisPoints Int
  termMonths Int
  remainingMonths Int
  monthlyPayment Int
  overduePeriods Int      @default(0)
  penaltyAccrued Int      @default(0)
  status    String       @default("active") @db.VarChar(16)
  createdAt DateTime     @default(now())
  settledAt DateTime?
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  config    LoanConfig    @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@index([profileId, status])
  @@index([configId])
}

model InvestorConfig {
  id        String       @id @db.VarChar(32)
  roundName String      @db.VarChar(16)
  name      String      @db.VarChar(48)
  focus     String      @db.VarChar(48)
  ticketSize Int
  valuationMultiplierBasisPoints Int
  equityBasisPoints Int
  successRateBase Int
  debtToleranceBasisPoints Int
  boardPressure Int
  term      String       @db.VarChar(180)
  summary   String       @db.VarChar(180)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  fundings  PlayerFunding[]

  @@index([sortOrder])
}

model PlayerFunding {
  id        String        @id @default(uuid()) @db.VarChar(36)
  profileId String       @db.VarChar(36)
  investorId String      @db.VarChar(32)
  roundName String       @db.VarChar(16)
  investorName String    @db.VarChar(48)
  amount    Int
  preMoneyValuation Int
  postMoneyValuation Int
  equityBasisPoints Int
  successRate Int
  boardPressure Int
  term      String        @db.VarChar(180)
  status    String        @default("pending") @db.VarChar(16)
  resultSummary String?   @db.VarChar(220)
  createdAt DateTime      @default(now())
  resolvedAt DateTime?
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  investor  InvestorConfig @relation(fields: [investorId], references: [id], onDelete: Restrict)

  @@index([profileId, status])
  @@index([investorId])
}

model ProductConfig {
  id        String          @id @db.VarChar(32)
  name      String          @db.VarChar(48)
  category  String          @db.VarChar(24)
  summary   String          @db.VarChar(180)
  launchCost Int
  baseUsers Int
  retentionBasisPoints Int
  payRateBasisPoints Int
  revenuePerPayingUser Int
  acquisitionCost Int
  serverCost Int
  techDebtGrowth Int
  reputationGrowth Int
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  products  PlayerProduct[]

  @@index([sortOrder])
}

model PlayerProduct {
  id        String        @id @default(uuid()) @db.VarChar(36)
  profileId String       @db.VarChar(36)
  configId  String       @db.VarChar(32)
  name      String       @db.VarChar(48)
  category  String       @db.VarChar(24)
  stage     String       @default("idea") @db.VarChar(16)
  users     Int          @default(0)
  retentionBasisPoints Int
  payRateBasisPoints Int
  acquisitionCost Int
  serverCost Int
  reputationScore Int    @default(50)
  techDebt  Int          @default(0)
  monthlyRevenue Int     @default(0)
  status    String       @default("active") @db.VarChar(16)
  resultSummary String?  @db.VarChar(220)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  closedAt  DateTime?
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  config    ProductConfig @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@unique([profileId, configId])
  @@index([profileId, status])
  @@index([configId])
}

model MarketTrackConfig {
  id        String        @id @db.VarChar(32)
  name      String        @db.VarChar(48)
  summary   String        @db.VarChar(180)
  costStructure String    @db.VarChar(80)
  industryHeat Int
  policyRisk Int
  baseShareBasisPoints Int
  customerPool Int
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  states    PlayerMarketState[]
  actions   CompetitorActionConfig[]

  @@index([sortOrder])
}

model PlayerMarketState {
  id        String        @id @default(uuid()) @db.VarChar(36)
  profileId String       @db.VarChar(36)
  trackId   String       @db.VarChar(32)
  trackName String       @db.VarChar(48)
  playerShareBasisPoints Int
  competitorShareBasisPoints Int
  industryHeat Int
  policyRisk Int
  pricePressure Int      @default(0)
  talentPressure Int     @default(0)
  reputationPressure Int @default(0)
  patentRisk Int         @default(0)
  resultSummary String?  @db.VarChar(220)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  track     MarketTrackConfig @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@unique([profileId, trackId])
  @@index([profileId])
  @@index([trackId])
}

model CompetitorActionConfig {
  id        String        @id @db.VarChar(40)
  trackId   String       @db.VarChar(32)
  competitorName String  @db.VarChar(48)
  actionType String      @db.VarChar(24)
  title     String       @db.VarChar(64)
  summary   String       @db.VarChar(180)
  cashImpact Int
  monthlyIncomeImpact Int
  monthlyExpenseImpact Int
  reputationImpact Int
  employeeSatisfactionImpact Int
  customerSatisfactionImpact Int
  marketShareDeltaBasisPoints Int
  competitorShareDeltaBasisPoints Int
  pricePressure Int
  talentPressure Int
  policyRiskDelta Int
  responseCost Int
  responseShareDeltaBasisPoints Int
  responseReputationImpact Int
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  track     MarketTrackConfig @relation(fields: [trackId], references: [id], onDelete: Cascade)
  playerActions PlayerCompetitorAction[]

  @@index([trackId, sortOrder])
  @@index([actionType])
}

model PlayerCompetitorAction {
  id        String        @id @default(uuid()) @db.VarChar(36)
  profileId String       @db.VarChar(36)
  actionId  String       @db.VarChar(40)
  trackId   String       @db.VarChar(32)
  competitorName String  @db.VarChar(48)
  actionType String      @db.VarChar(24)
  title     String       @db.VarChar(64)
  summary   String       @db.VarChar(180)
  status    String       @default("pending") @db.VarChar(16)
  response  String?      @db.VarChar(16)
  resultSummary String?  @db.VarChar(220)
  createdAt DateTime     @default(now())
  resolvedAt DateTime?
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  config    CompetitorActionConfig @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@index([profileId, status])
  @@index([actionId])
}

model CompanyFinanceReport {
  id          String        @id @default(uuid()) @db.VarChar(36)
  profileId   String        @db.VarChar(36)
  reportMonth Int
  income      Int
  expense     Int
  netCashFlow Int
  endingCash  Int
  totalDebt   Int
  debtRatioBasisPoints Int
  riskStatus String        @db.VarChar(16)
  riskTips   String        @db.Text
  createdAt   DateTime     @default(now())
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, reportMonth])
  @@index([profileId, createdAt])
}

model TaskConfig {
  id              String               @id @db.VarChar(48)
  type            String               @db.VarChar(16)
  title           String               @db.VarChar(48)
  description     String               @db.VarChar(160)
  target          Int
  initialProgress Int                  @default(0)
  rewardLabel     String               @db.VarChar(80)
  rewardCash      Int                  @default(0)
  rewardPlatformCoins Int              @default(0)
  rewardReputation Int                 @default(0)
  rewardActionPower Int                @default(0)
  guideAction     String               @db.VarChar(32)
  unlockKind      String               @default("none") @db.VarChar(24)
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  progresses      PlayerTaskProgress[]

  @@index([type, sortOrder])
}

model PlayerTaskProgress {
  id          String        @id @default(uuid()) @db.VarChar(36)
  profileId   String        @db.VarChar(36)
  taskId      String        @db.VarChar(48)
  progress    Int           @default(0)
  dailyDate   String?       @db.VarChar(10)
  claimedAt   DateTime?
  updatedAt   DateTime      @updatedAt
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  task        TaskConfig    @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([profileId, taskId])
  @@index([profileId, updatedAt])
  @@index([taskId])
}
